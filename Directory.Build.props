<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WPF 字体缓存需要真实的区域文化数据（如 en-us）；不变全球化模式会让
         MainWindow.Show() 抛 InvalidOperationException: Cannot find non-neutral culture related to 'en-us'。 -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;NU1701</NoWarn>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    <Product>LAN Transfer</Product>
    <Company>LAN Transfer</Company>
  </PropertyGroup>

</Project>
