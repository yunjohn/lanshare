<UserControl x:Class="LanTransfer.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LanTransfer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DiagnosticsViewModel}"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="26,23,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================= 顶部 ======================= -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="网络诊断" Style="{StaticResource TitleText}" />
                <TextBlock Text="查看本机网络环境、服务端口状态，并测试到目标电脑的连通性。"
                           Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="刷新" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Click="OnRefreshClick" />
                <Button Content="复制诊断信息" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CopyDiagnosticsCommand}" />
            </StackPanel>
        </Grid>

        <!-- ======================= 主体 ======================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ============ 左列 ============ -->
                <StackPanel Grid.Column="0">

                    <!-- 本机身份 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="本机身份" Style="{StaticResource SectionTitleText}" />

                            <TextBlock Text="设备名称" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding DeviceName}" Style="{StaticResource BodyText}" Margin="0,3,0,8" />

                            <TextBlock Text="DeviceId" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding DeviceId}" Style="{StaticResource MonoText}" Margin="0,3,0,8" />

                            <TextBlock Text="证书指纹（SHA-256）" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding Fingerprint}" Style="{StaticResource MonoText}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 服务状态 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="服务状态" Style="{StaticResource SectionTitleText}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="UDP 发现端口"
                                           Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DiscoveryPort}"
                                           Style="{StaticResource BodyText}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="TCP 传输端口"
                                           Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TransferPort}"
                                           Style="{StaticResource BodyText}" Margin="0,6,0,0" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="传输服务"
                                           Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ServerStateText}"
                                           Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="设备发现"
                                           Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiscoveryStateText}"
                                           Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="网络类别"
                                           Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding NetworkCategoryText}"
                                           Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="接收目录"
                                           Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DownloadPath}"
                                           Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </Grid>

                            <TextBlock Text="{Binding ChunkSizeText, StringFormat=分块大小：{0}}"
                                       Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 网络接口 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="网络接口" Style="{StaticResource SectionTitleText}" />

                            <ItemsControl ItemsSource="{Binding Interfaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                                                Padding="0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0"
                                                           TextWrapping="Wrap">
                                                    <Run Text="{Binding InterfaceType, Mode=OneWay}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding IPv4Address, Mode=OneWay}" />
                                                    <Run Text="  /  掩码 " />
                                                    <Run Text="{Binding SubnetMask, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap">
                                                    <Run Text="广播 " />
                                                    <Run Text="{Binding BroadcastAddress, Mode=OneWay}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding SpeedBitsPerSecond, Mode=OneWay}" />
                                                    <Run Text=" bps" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="未检测到 IPv4 网络接口。" Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Interfaces.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ 右列 ============ -->
                <StackPanel Grid.Column="2">

                    <!-- 连通性测试 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="连通性测试" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="输入对方电脑的 IP 地址与端口，测试 TCP 连接与 HTTPS 服务响应。"
                                       Style="{StaticResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="目标 IP / 主机名" Style="{StaticResource MutedText}" />
                                    <TextBox Text="{Binding TargetHost, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBox}" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="端口" Style="{StaticResource MutedText}" />
                                    <TextBox Text="{Binding TargetPort, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBox}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <Button Content="开始测试" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding TestConnectionCommand}" />

                            <!-- 测试结果 -->
                            <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                                    Visibility="{Binding TestResult, Converter={StaticResource StringToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FDECEC" />
                                        <Setter Property="BorderBrush" Value="#F5AFAF" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestSucceeded}" Value="True">
                                                <Setter Property="Background" Value="#EAF7EE" />
                                                <Setter Property="BorderBrush" Value="#A9DCB9" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock Text="{Binding TestResult}" Style="{StaticResource MonoText}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- 测试日志 -->
                            <ItemsControl ItemsSource="{Binding TestLog}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource SecondaryText}"
                                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 已发现设备 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="已发现设备" Style="{StaticResource SectionTitleText}" />

                            <ItemsControl ItemsSource="{Binding DiscoveredDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource BodyText}"
                                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="当前没有发现任何设备。" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiscoveredDevices.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 防火墙提示 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                            Background="#FFF7E6" BorderBrush="#F5D08A">
                        <StackPanel>
                            <TextBlock Text="防火墙提示" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{Binding FirewallHint}" Style="{StaticResource SecondaryText}"
                                       Foreground="#8A5B00" TextWrapping="Wrap" />
                            <TextBlock Text="若需放行端口，请到「设置」页使用「添加防火墙规则」按钮（只会开放本程序端口，不会关闭防火墙）。"
                                       Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
