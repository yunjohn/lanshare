<Window x:Class="LanTransfer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LanTransfer.App.Views"
        xmlns:vm="clr-namespace:LanTransfer.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="LAN Transfer — 局域网文件传输与同步" Icon="/Assets/app-icon.ico"
        Height="780" Width="1220" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="22,25,18,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="11" Background="#247CFF">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LAN Transfer" Foreground="White" FontSize="15.5" FontWeight="SemiBold" />
                        <TextBlock Text="局域网协作空间" Foreground="#8190A8" FontSize="10.5" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Text="工作台" Foreground="#66758F" FontSize="10.5"
                           FontWeight="SemiBold" Margin="23,0,0,8" />

                <ListBox Grid.Row="2" Margin="10,0" ItemsSource="{Binding NavigationItems}"
                         SelectedIndex="{Binding SelectedNavigationIndex}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Foreground" Value="#AAB5C6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="9" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="4" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="NavIcon" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}"
                                                           Foreground="{TemplateBinding Foreground}" FontSize="13" VerticalAlignment="Center" />
                                                <Border x:Name="Marker" Grid.Column="2" Width="3" Height="18"
                                                        Background="#4C9AFF" CornerRadius="2" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="Content" Value="文件传输"><Setter TargetName="NavIcon" Property="Text" Value="&#xE898;" /></Trigger>
                                            <Trigger Property="Content" Value="同步任务"><Setter TargetName="NavIcon" Property="Text" Value="&#xE895;" /></Trigger>
                                            <Trigger Property="Content" Value="设备"><Setter TargetName="NavIcon" Property="Text" Value="&#xE770;" /></Trigger>
                                            <Trigger Property="Content" Value="历史记录"><Setter TargetName="NavIcon" Property="Text" Value="&#xE81C;" /></Trigger>
                                            <Trigger Property="Content" Value="网络诊断"><Setter TargetName="NavIcon" Property="Text" Value="&#xE968;" /></Trigger>
                                            <Trigger Property="Content" Value="设置"><Setter TargetName="NavIcon" Property="Text" Value="&#xE713;" /></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#17243A" />
                                                <Setter Property="Foreground" Value="#E5ECF5" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1D3150" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Border Grid.Row="3" Margin="12,10,12,16" Padding="13"
                        Background="{StaticResource SidebarElevatedBrush}" CornerRadius="11">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="本机端点" Foreground="#8391A7" FontSize="10.5" />
                            <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#E14C4C" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServerRunning}" Value="True"><Setter Property="Fill" Value="#2BC48A" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding LocalDeviceText}" Foreground="#EDF2F8"
                                   FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Margin="0,6,0,0" ToolTip="{Binding LocalDeviceText}" />
                        <TextBlock Grid.Row="2" Text="{Binding ServerStatusText}" Foreground="#8493A9"
                                   FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="16" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <views:TransferView DataContext="{Binding Transfer}" Visibility="{Binding DataContext.SelectedNavigationIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexVisibility}, ConverterParameter=0}" />
                <views:SyncView DataContext="{Binding Sync}" Visibility="{Binding DataContext.SelectedNavigationIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexVisibility}, ConverterParameter=1}" />
                <views:DevicesView DataContext="{Binding DevicesPage}" Visibility="{Binding DataContext.SelectedNavigationIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexVisibility}, ConverterParameter=2}" />
                <views:HistoryView DataContext="{Binding History}" Visibility="{Binding DataContext.SelectedNavigationIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexVisibility}, ConverterParameter=3}" />
                <views:DiagnosticsView DataContext="{Binding Diagnostics}" Visibility="{Binding DataContext.SelectedNavigationIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexVisibility}, ConverterParameter=4}" />
                <views:SettingsView DataContext="{Binding SettingsPage}" Visibility="{Binding DataContext.SelectedNavigationIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexVisibility}, ConverterParameter=5}" />
            </Grid>
            <Border Grid.Row="1" Margin="20,0,20,16" Padding="14,10" CornerRadius="9"
                    Background="#EAF3FF" BorderBrush="#C5DCF9" BorderThickness="1"
                    Visibility="{Binding HasToast, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ToastMessage}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="关闭" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Command="{Binding DismissToastCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
