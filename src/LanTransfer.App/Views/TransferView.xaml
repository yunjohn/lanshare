<UserControl x:Class="LanTransfer.App.Views.TransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LanTransfer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:TransferViewModel}"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragEnter="OnDragOver"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="26,23,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="文件传输" Style="{StaticResource TitleText}" />
                <TextBlock Text="选择附近设备，或直接把文件拖入发送区域" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#FFFFFF" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="9" Padding="11,7" Margin="0,0,9,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LocalDeviceName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LocalIpAddress, StringFormat=  ·  {0}}" Style="{StaticResource MonoText}" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" ToolTip="重新发现局域网设备">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Environment warning -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="13,11" CornerRadius="9"
                Background="#FFF7E8" BorderBrush="#F5D9A8" BorderThickness="1"
                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource WarningBrush}"
                           FontSize="15" VerticalAlignment="Top" Margin="1,1,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding WarningMessage}" Style="{StaticResource SecondaryText}"
                           Foreground="#8B5C16" LineHeight="19" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="318" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Device picker -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="17,16,17,12">
                        <StackPanel>
                            <TextBlock Text="发送到" Style="{StaticResource SectionTitleText}" Margin="0" />
                            <TextBlock Text="局域网内可用设备" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF8F4" CornerRadius="12" Padding="8,4">
                            <TextBlock Text="{Binding Devices.Count, StringFormat={}{0} 台}" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="8,0,8,8">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVisibility}}">
                            <Border Width="52" Height="52" CornerRadius="26" Background="#EEF4FB" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8CE;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#7890AD"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="没有发现设备" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock Text="确认对方已启动，或手动输入 IP 连接" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                 Style="{StaticResource PlainListBox}"
                                 Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="9" Background="#E9F2FF" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0">
                                                <Run Text="{Binding IpAddress, Mode=OneWay}" /><Run Text=":" /><Run Text="{Binding Port, Mode=OneWay}" />
                                                <Run Text="  ·  " /><Run Text="{Binding TrustText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#CBD3DE" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14">
                        <StackPanel>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleAddDevicePanelCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0" />
                                    <TextBlock Text="手动添加 IP 设备" />
                                </StackPanel>
                            </Button>
                            <Border Background="#F7F9FC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="9" Padding="12" Margin="0,10,0,0"
                                    Visibility="{Binding IsAddDevicePanelOpen, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="IP 地址" Style="{StaticResource MutedText}" />
                                    <TextBox Text="{Binding ManualIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0,4,0,8" />
                                    <TextBlock Text="端口（默认 39521）" Style="{StaticResource MutedText}" />
                                    <TextBox Text="{Binding ManualPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0,4,0,9" />
                                    <Button Content="连接设备" Style="{StaticResource PrimaryButton}" Command="{Binding AddManualDeviceCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Send surface and queue -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource DropZoneBorder}" MinHeight="152">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="8,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44" Height="44" CornerRadius="12" Background="#E5F0FF" Margin="0,0,13,0">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="拖放到这里，立即发送" Style="{StaticResource BodyText}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="支持多文件和完整文件夹，传输中断后可继续" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryText}" Margin="57,12,0,0"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="138">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding SendFilesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0" />
                                    <TextBlock Text="选择文件" />
                                </StackPanel>
                            </Button>
                            <Button Content="选择文件夹" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Command="{Binding SendFolderCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="17,15,14,11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="传输队列" Style="{StaticResource SectionTitleText}" Margin="0" />
                                <Border Background="#F1F4F8" CornerRadius="11" Padding="7,3" Margin="9,0,0,0">
                                    <TextBlock Text="{Binding Transfers.Count}" Style="{StaticResource MutedText}" />
                                </Border>
                            </StackPanel>
                            <Button Content="清空已完成" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Command="{Binding ClearHistoryCommand}" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="8,0,8,8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasTransfers, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="#B7C2D0" HorizontalAlignment="Center" />
                                <TextBlock Text="队列是空的" Style="{StaticResource BodyText}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock Text="选择左侧设备，然后发送文件" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasTransfers, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Transfers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FAFBFD" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                                    CornerRadius="9" Padding="13" Margin="1,1,1,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0">
                                                                <Run Text="{Binding Direction, Converter={StaticResource DirectionArrow}, Mode=OneWay}" /><Run Text="  ·  " />
                                                                <Run Text="{Binding SubTitle, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding FileCountText, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="#EDF4FF" CornerRadius="11" Padding="8,4" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource BadgeText}"
                                                                       Foreground="{Binding State, Converter={StaticResource StateBrush}}" />
                                                        </Border>
                                                    </Grid>
                                                    <ProgressBar Style="{StaticResource TransferProgress}" Margin="0,12,0,7" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                                                    <Grid>
                                                        <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center">
                                                            <Run Text="{Binding Percent, Converter={StaticResource Percent}, Mode=OneWay}" /><Run Text="  " />
                                                            <Run Text="{Binding ProgressText, Mode=OneWay}" /><Run Text="  ·  " />
                                                            <Run Text="{Binding SpeedText, Mode=OneWay}" /><Run Text="  ·  剩余 " /><Run Text="{Binding EtaText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="暂停" Style="{StaticResource LinkButton}" Command="{Binding PauseCommand}" Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}" />
                                                            <Button Content="继续" Style="{StaticResource LinkButton}" Command="{Binding ResumeCommand}" Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}" />
                                                            <Button Content="取消" Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}" Command="{Binding CancelCommand}" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                                            <Button Content="删除未完成文件" Style="{StaticResource LinkButton}" Command="{Binding DeleteCommand}" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource MutedText}" Foreground="{StaticResource DangerBrush}"
                                                               Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
