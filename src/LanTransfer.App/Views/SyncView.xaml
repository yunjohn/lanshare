<UserControl x:Class="LanTransfer.App.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LanTransfer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SyncViewModel}"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="26,23,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= 顶部 ======================= -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="同步任务" Style="{StaticResource TitleText}" />
                <TextBlock Text="建立双向文件夹同步关系，自动同步新增、修改与删除（默认每 10 分钟全量扫描一次）。"
                           Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            </StackPanel>

            <Button Content="新建同步关系" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding CreatePairCommand}" />
        </Grid>

        <!-- ======================= 主体 ======================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：同步关系列表 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="同步关系" Style="{StaticResource SectionTitleText}" />

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                    <Grid>
                        <TextBlock Text="还没有同步关系&#x0a;&#x0a;点击右上角「新建同步关系」，&#x0a;选择本机目录与目标设备即可开始。"
                                   Style="{StaticResource MutedText}"
                                   TextAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasPairs, Converter={StaticResource InverseBoolToVisibility}}" />

                        <ListBox ItemsSource="{Binding Pairs}"
                                 SelectedItem="{Binding SelectedPair}"
                                 Style="{StaticResource PlainListBox}"
                                 Visibility="{Binding HasPairs, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="12,10"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource BadgeText}"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Grid>

                                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding RemoteDeviceName, Mode=OneWay}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{Binding Mode, Converter={StaticResource EnumDisplay}, Mode=OneWay}" />
                                            </TextBlock>

                                            <TextBlock Text="{Binding LocalPath}" Style="{StaticResource MutedText}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

                                            <TextBlock Text="{Binding LastSyncText}" Style="{StaticResource MutedText}"
                                                       Margin="0,4,0,0" />

                                            <TextBlock Text="{Binding LastError}" Style="{StaticResource MutedText}"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右：选中关系详情 + 冲突 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 详情卡片 -->
                <Border Grid.Row="0" Style="{StaticResource Card}"
                        Visibility="{Binding SelectedPair, Converter={StaticResource ObjectToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedPair.Name}" Style="{StaticResource SectionTitleText}" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="本机目录" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPair.LocalPath}"
                                       Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="对端目录" Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPair.RemotePath}"
                                       Style="{StaticResource BodyText}" Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="目标设备" Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPair.RemoteDeviceName}"
                                       Style="{StaticResource BodyText}" Margin="0,6,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="同步模式" Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding SelectedPair.Mode, Converter={StaticResource EnumDisplay}}"
                                       Style="{StaticResource BodyText}" Margin="0,6,0,0" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="状态" Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedPair.StatusText}"
                                       Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="立即同步" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SyncNowCommand}" />
                            <Button Content="打开本机目录" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding SelectedPair.OpenFolderCommand}" />
                            <Button Content="启用 / 停用" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding SelectedPair.ToggleEnabledCommand}" />
                            <Button Content="删除同步关系" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                    Command="{Binding SelectedPair.DeleteCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Style="{StaticResource Card}"
                        Visibility="{Binding SelectedPair, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="在左侧选择一个同步关系查看详情。" Style="{StaticResource MutedText}" />
                </Border>

                <!-- 冲突列表 -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="冲突待裁决" Style="{StaticResource SectionTitleText}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <TextBlock Text="当前没有待裁决的冲突。&#x0a;双方同时修改同一文件时会自动保留两个版本并在此列出。"
                                       Style="{StaticResource MutedText}" Margin="0,12,0,0"
                                       Visibility="{Binding HasConflicts, Converter={StaticResource InverseBoolToVisibility}}" />

                            <ItemsControl ItemsSource="{Binding Conflicts}"
                                          Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RelativePath}" Style="{StaticResource BodyText}"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding ConflictCopyPath, Converter={StaticResource StringToVisibility}}">
                                                    <Run Text="冲突副本：" />
                                                    <Run Text="{Binding ConflictCopyPath, Mode=OneWay}" />
                                                </TextBlock>

                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Button Content="保留本机版本" Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding DataContext.ResolveConflictCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Converter={StaticResource ConflictRequest},
                                                                               ConverterParameter=UseLocal}" />
                                                    <Button Content="保留对端版本" Style="{StaticResource SecondaryButton}"
                                                            Margin="8,0,0,0"
                                                            Command="{Binding DataContext.ResolveConflictCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Converter={StaticResource ConflictRequest},
                                                                               ConverterParameter=UseRemote}" />
                                                    <Button Content="两个都保留" Style="{StaticResource SecondaryButton}"
                                                            Margin="8,0,0,0"
                                                            Command="{Binding DataContext.ResolveConflictCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Converter={StaticResource ConflictRequest},
                                                                               ConverterParameter=KeepBoth}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ======================= 底部状态 ======================= -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12,9" CornerRadius="6"
                Background="{StaticResource HoverBrush}"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryText}" />
        </Border>
    </Grid>
</UserControl>
