<UserControl x:Class="LanTransfer.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LanTransfer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DevicesViewModel}"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="26,23,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= 顶部 ======================= -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="设备" Style="{StaticResource TitleText}" />
                <TextBlock Text="查看已发现设备、完成可信配对、测试连通性。只有配对过的设备才被视为可信。"
                           Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            </StackPanel>

            <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding ProbeCommand}" />
        </Grid>

        <!-- ======================= 主体 ======================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：设备列表 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="设备列表" Style="{StaticResource SectionTitleText}" />

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                    <Grid>
                        <TextBlock Text="暂未发现设备。&#x0a;&#x0a;请确认对方已运行 LAN Transfer，&#x0a;或到「文件传输」页手工添加 IP。"
                                   TextAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListBox ItemsSource="{Binding Devices}"
                                 SelectedItem="{Binding SelectedDevice}"
                                 Style="{StaticResource PlainListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="12,10"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,10,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DeviceName}"
                                                           Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                                                    <Run Text="{Binding EndPoint, Mode=OneWay}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding TrustText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右：设备详情 -->
            <Grid Grid.Column="2">
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedDevice.DeviceName}"
                                   Style="{StaticResource SectionTitleText}" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="IP 地址" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDevice.IpAddress}"
                                       Style="{StaticResource BodyText}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="端口" Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.Port}"
                                       Style="{StaticResource BodyText}" Margin="0,6,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="程序版本" Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDevice.AppVersion}"
                                       Style="{StaticResource BodyText}" Margin="0,6,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="在线状态" Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding SelectedDevice.OnlineState, Converter={StaticResource EnumDisplay}}"
                                       Style="{StaticResource BodyText}" Margin="0,6,0,0" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="信任状态" Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDevice.TrustText}"
                                       Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                        </Grid>

                        <!-- 身份变化警告 -->
                        <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="6"
                                Background="#FDECEC" BorderBrush="#F5AFAF" BorderThickness="1"
                                Visibility="{Binding SelectedDevice.IsIdentityChanged,
                                             Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource SecondaryText}" Foreground="#8A1F1F"
                                       Text="该设备的证书指纹与配对时不一致，可能已重装程序或存在安全风险。请解除信任后重新配对。" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="发送文件" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SelectedDevice.SendCommand}" />
                            <Button Content="测试连接" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding TestCommand}" />
                            <Button Content="配对" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding PairCommand}"
                                    Visibility="{Binding CanPair, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="解除信任" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                    Command="{Binding RevokeCommand}"
                                    Visibility="{Binding CanRevoke, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="移除设备" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                    Command="{Binding SelectedDevice.RemoveCommand}" />
                        </StackPanel>

                        <TextBlock Text="配对时两端会显示同一个 6 位验证码，请比对一致后再确认。"
                                   Style="{StaticResource MutedText}" Margin="0,14,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="在左侧选择一台设备查看详情。" Style="{StaticResource MutedText}" />
                </Border>
            </Grid>
        </Grid>

        <!-- ======================= 底部状态 ======================= -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12,9" CornerRadius="6"
                Background="{StaticResource HoverBrush}"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryText}" />
        </Border>
    </Grid>
</UserControl>
