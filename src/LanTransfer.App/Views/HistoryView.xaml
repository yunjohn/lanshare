<UserControl x:Class="LanTransfer.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LanTransfer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="26,23,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================= 顶部 ======================= -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="历史记录" Style="{StaticResource TitleText}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox Content="只看已完成" Style="{StaticResource SwitchCheck}"
                          VerticalAlignment="Center" Margin="0,0,14,0"
                          IsChecked="{Binding ShowCompletedOnly}" />
                <Button Content="清空历史" Style="{StaticResource DangerButton}"
                        Command="{Binding ClearCommand}" />
            </StackPanel>
        </Grid>

        <!-- ======================= 表头 ======================= -->
        <Border Grid.Row="1" Padding="12,8" CornerRadius="6"
                Background="{StaticResource HoverBrush}"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="方向" Style="{StaticResource MutedText}" />
                <TextBlock Grid.Column="1" Text="名称" Style="{StaticResource MutedText}" />
                <TextBlock Grid.Column="2" Text="设备" Style="{StaticResource MutedText}" />
                <TextBlock Grid.Column="3" Text="大小" Style="{StaticResource MutedText}" />
                <TextBlock Grid.Column="4" Text="状态" Style="{StaticResource MutedText}" />
                <TextBlock Grid.Column="5" Text="时间" Style="{StaticResource MutedText}" />
                <TextBlock Grid.Column="6" Text="操作" Style="{StaticResource MutedText}" />
            </Grid>
        </Border>

        <!-- ======================= 列表 ======================= -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="还没有历史记录。完成一次传输后，这里会列出全部记录。"
                       Style="{StaticResource MutedText}" Margin="0,20,0,0"
                       Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FlatCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding DirectionText}"
                                                   Style="{StaticResource BodyText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding NameText}"
                                                   Style="{StaticResource BodyText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding DeviceText}"
                                                   Style="{StaticResource BodyText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}"
                                                   Style="{StaticResource BodyText}" />
                                        <TextBlock Grid.Column="4" Text="{Binding StateText}"
                                                   Style="{StaticResource BodyText}" />
                                        <TextBlock Grid.Column="5" Text="{Binding TimeText}"
                                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" />

                                        <Button Grid.Column="6" Content="打开目录"
                                                Style="{StaticResource LinkButton}"
                                                Click="OnOpenFolderClick"
                                                IsEnabled="{Binding CanOpenFolder}" />
                                    </Grid>

                                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource MutedText}"
                                               Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Text="{Binding DurationText}" Style="{StaticResource MutedText}"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding DurationText, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
