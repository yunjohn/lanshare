<Window x:Class="LanTransfer.App.Views.Dialogs.CreateSyncPairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建同步关系"
        Width="540" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Border Style="{StaticResource DialogCard}" Margin="14">
        <StackPanel>
            <TextBlock Text="新建同步关系" Style="{StaticResource TitleText}" />
            <TextBlock Text="创建后本机会向对方发起同步请求，由对方确认本机目录后生效。"
                       Style="{StaticResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <!-- 名称：TextBox.Text 默认 TwoWay，而这些属性是只读的默认值载体，
                 必须显式 OneWay，否则弹窗一 ShowDialog 就抛
                 "A TwoWay or OneWayToSource binding cannot work on the read-only property"。 -->
            <TextBlock Text="同步名称" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
            <TextBox x:Name="PairNameBox" Style="{StaticResource InputBox}" Margin="0,4,0,0"
                     Text="{Binding DefaultPairName, Mode=OneWay}" />

            <!-- 本机目录 -->
            <TextBlock Text="本机目录" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LocalPathBox" Grid.Column="0" Style="{StaticResource InputBox}"
                         Text="{Binding DefaultLocalPath, Mode=OneWay}" />
                <Button Grid.Column="2" Content="浏览…" Style="{StaticResource SecondaryButton}"
                        Click="OnBrowseLocalClick" />
            </Grid>

            <!-- 对端 -->
            <TextBlock Text="对端设备" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" IsReadOnly="True"
                     Text="{Binding RemoteDeviceName, Mode=OneWay}" />

            <TextBlock Text="对端目录（对方电脑上用于同步的绝对路径）" Style="{StaticResource MutedText}"
                       Margin="0,12,0,0" />
            <TextBox x:Name="RemotePathBox" Style="{StaticResource InputBox}" Margin="0,4,0,0"
                     Text="{Binding DefaultRemotePath, Mode=OneWay}" />

            <!-- 模式 -->
            <TextBlock Text="同步模式" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
            <ComboBox x:Name="ModeBox" Style="{StaticResource InputCombo}" Margin="0,4,0,0" Width="260"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding Modes}"
                      SelectedItem="{Binding SelectedMode}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="提示：V1 仅由发起方驱动同步规划。双方同时修改同一文件时会自动保留两个版本，并在「同步任务」页列出冲突等待裁决。"
                       Style="{StaticResource MutedText}" Margin="0,14,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" MinWidth="90"
                        Click="OnCancelClick" />
                <Button Content="创建" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="10,0,0,0"
                        Click="OnCreateClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
